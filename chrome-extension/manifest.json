{
  "manifest_version": 3,
  "name": "TokenScope Cookie 采集器",
  "version": "1.1.0",
  "description": "一键采集各平台 Cookie 并推送到 TokenScope 监控面板",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://*.cloud.tencent.com/*",
    "*://*.volcengine.com/*",
    "*://*.xiaomimimo.com/*",
    "*://*.deepseek.com/*",
    "https://ait.ll264a.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://cloud.tencent.com/*",
        "*://console.volcengine.com/*",
        "*://platform.xiaomimimo.com/*",
        "*://platform.deepseek.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
